## Example config for wd-e621-hydrus-tagger
# CLI flags always override these settings.
# Required for any Hydrus API commands

## Paste your hydrus API token below
token: YOUR_HYDRUS_API_TOKEN_HERE

## Optional flags — these are the defaults
host: "http://127.0.0.1:45869"
model: "wd-eva02-large-tagger-v3"
threshold: 0.6
tag_service: "A.I. Tags"
cpu: true
ratings_only: false
privacy: true

## Optional safety settings
# Pin the tag service by its key instead of its name (find it in Hydrus under
# services > review services, or in the error message if the name is ambiguous)
# tag_service_key: ""
# Most content tags written per file (highest scores first)
# max_tags: 150
# Seconds to wait for Hydrus to answer before giving up
# request_timeout: 600
